[debug] [2026-10-11T01:11:51.113Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/lilcare-afdf5/rulesets {"name":"projects/lilcare-afdf5/rulesets/3cf1e338-6e25-40c0-b118-5137c5d1a9ed","source":{"files":[{"content":"rules_version = '2';\nservice firebase.storage {\n  match /b/{bucket}/o {\n    function owner(doctorId) {\n      let principal = firestore.get(/databases/(default)/documents/securityPrincipals/$(request.auth.uid)).data;\n      let lease = firestore.get(/databases/(default)/documents/clinicSessions/$(request.auth.token.clinicSessionId)).data;\n      return principal.active == true && principal.authUid == request.auth.uid\n        && principal.role == 'doctor' && principal.userId == doctorId && principal.doctorId == doctorId\n        && lease.active == true && lease.authUid == request.auth.uid && lease.role == 'doctor'\n        && lease.expiresAt is timestamp && lease.expiresAt > request.time;\n    }\n    match /logos/{doctorId}/{fileName} {\n      // D06: logos are public by URL; listing objects remains restricted.\n      allow get: if true;\n      allow create, update: if request.auth != null && owner(doctorId)\n        && fileName.size() <= 512 && !fileName.matches('.*\\\\.\\\\..*')\n        && request.resource.size > 0 && request.resource.size <= 1048576\n        && request.resource.contentType.matches('image/(png|jpeg|svg\\\\+xml)');\n      allow delete: if request.auth != null && owner(doctorId);\n    }\n    match /{path=**} {\n      allow read, write: if false;\n    }\n  }\n}\n","name":"storage.rules"}]},"createTime":"2026-10-11T01:11:50.845263Z","metadata":{"services":["firebase.storage"]}}
