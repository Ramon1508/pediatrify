[debug] [2026-10-11T01:11:51.792Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/lilcare-afdf5/rulesets {"name":"projects/lilcare-afdf5/rulesets/c21d2cbd-54cf-406f-80bf-90dfecb34892","source":{"files":[{"content":"rules_version = '2';\r\nservice cloud.firestore {\r\n  match /databases/{database}/documents {\r\n    function signedIn() { return request.auth != null; }\r\n    function principal() { return get(/databases/$(database)/documents/securityPrincipals/$(request.auth.uid)).data; }\r\n    function lease() { return get(/databases/$(database)/documents/clinicSessions/$(request.auth.token.clinicSessionId)).data; }\r\n    function validLease() {\r\n      return signedIn() && request.auth.token.clinicSessionId is string\r\n        && lease().authUid == request.auth.uid && lease().active == true\r\n        && lease().expiresAt is timestamp && lease().expiresAt > request.time;\r\n    }\r\n    function base() {\r\n      return validLease() && principal().active == true && principal().authUid == request.auth.uid\r\n        && lease().role == principal().role;\r\n    }\r\n    function ownUser() { return get(/databases/$(database)/documents/users/$(principal().userId)).data; }\r\n    function staff(complete) {\r\n      return base() && principal().role in ['admin', 'doctor', 'assistant']\r\n        && ownUser().uid == principal().userId && ownUser().firebaseUid == request.auth.uid\r\n        && ownUser().role == principal().role\r\n        && !exists(/databases/$(database)/documents/staffDeletionJobs/$(principal().userId))\r\n        && (!complete || (ownUser().pending != true && ownUser().profileComplete == true))\r\n        && (principal().role != 'doctor' || principal().doctorId == principal().userId)\r\n        && (principal().role != 'assistant' || ownUser().createdBy == principal().doctorId)\r\n        && (principal().role != 'admin' || !('doctorId' in principal()));\r\n    }\r\n    function liveDoctor(doctorId) {\r\n      let profile = get(/databases/$(database)/documents/users/$(doctorId)).data;\r\n      let authority = get(/databases/$(database)/documents/securityPrincipals/$(profile.firebaseUid)).data;\r\n      return profile.uid == doctorId && profile.role == 'doctor' && profile.profileComplete == true\r\n        && profile.pending != true && authority.active == true && authority.role == 'doctor'\r\n        && authority.authUid == profile.firebaseUid && authority.userId == doctorId && authority.doctorId == doctorId\r\n        && !exists(/databases/$(database)/documents/staffDeletionJobs/$(doctorId));\r\n    }\r\n    function team(doctorId) {\r\n      return staff(true) && principal().role in ['doctor', 'assistant'] && principal().doctorId == doctorId\r\n        && liveDoctor(doctorId);\r\n    }\r\n    function agenda(doctorId) { return team(doctorId); }\r\n    function inbox(data) {\n      return team(data.doctorId) && data.recipientId == principal().userId && data.recipientType == principal().role;\n    }\r\n    function validReadNotification(data, id) {\r\n      return data.keys().hasOnly(['id', 'type', 'title', 'description', 'appointmentId', 'doctorId', 'createdAt', 'originatorId', 'originatorName', 'recipientId', 'recipientType', 'read'])\r\n        && data.keys().hasAll(['id', 'type', 'title', 'description', 'doctorId', 'createdAt', 'originatorId', 'originatorName', 'recipientId', 'recipientType', 'read'])\r\n        && data.id == id && data.id is string && data.id.size() <= 128\r\n        && data.type in ['appointment-created', 'appointment-cancelled', 'appointment-rescheduled']\r\n        && data.title is string && data.title.size() <= 262144\r\n        && data.description is string && data.description.size() <= 262144\r\n        && (!('appointmentId' in data) || (data.appointmentId is string && data.appointmentId.size() <= 128))\r\n        && data.doctorId is string && data.doctorId.size() <= 128\r\n        && data.createdAt is timestamp && data.originatorId is string && data.originatorId.size() <= 128\r\n        && data.originatorName is string && data.originatorName.size() <= 262144\r\n        && data.recipientId is string && data.recipientId.size() <= 128\r\n        && data.recipientType in ['doctor', 'assistant', 'patient'] && data.read == true;\r\n    }\r\n\r\n    match /securityPrincipals/{uid} {\r\n      allow get: if signedIn() && request.auth.uid == uid && resource.data.role in ['admin', 'doctor', 'assistant'];\r\n    }\r\n    match /clinicSessions/{id} {\r\n      allow get: if signedIn() && request.auth.token.clinicSessionId == id && resource.data.authUid == request.auth.uid && resource.data.role in ['admin', 'doctor', 'assistant'];\r\n    }\r\n    match /patientSessionStatus/{patientId} { allow read, write: if false; }\r\n    match /users/{uid} {\r\n      allow get: if staff(false) && principal().userId == uid;\r\n    }\r\n    match /staffDirectory/{uid} {\r\n      allow read: if staff(true) && ((principal().role == 'admin' && resource.data.role in ['admin', 'doctor'])\r\n        || (principal().role == 'doctor' && resource.data.role == 'assistant' && resource.data.createdBy == principal().userId));\r\n    }\r\n    match /doctorProfiles/{doctorId} {\r\n      allow get: if agenda(doctorId);\r\n    }\r\n    match /schedules/{doctorId} {\r\n      allow get: if agenda(doctorId);\r\n    }\r\n    match /patients/{patientId} {\r\n      allow read: if team(resource.data.doctorId) && principal().role == 'doctor';\r\n    }\r\n    match /patientDirectory/{patientId} {\r\n      allow read: if team(resource.data.doctorId);\r\n    }\r\n    match /patientPortal/{patientId} { allow read, write: if false; }\r\n    match /appointments/{id} {\r\n      allow read: if team(resource.data.doctorId)\r\n        || (signedIn() && resource.data.doctorId == principal().doctorId && family(resource.data.patientId));\r\n    }\r\n    match /appointmentSlots/{id} {\r\n      allow read: if agenda(resource.data.doctorId);\r\n    }\r\n    match /clinicalRecords/{id} {\r\n      allow read: if team(resource.data.doctorId) && principal().role == 'doctor';\r\n    }\r\n    match /notifications/{id} {\r\n      allow read: if inbox(resource.data);\r\n      allow update: if inbox(resource.data) && validReadNotification(request.resource.data, id)\r\n        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);\r\n    }\r\n    match /auditLog/{id} {\r\n      allow read: if staff(true) && principal().role == 'admin';\r\n    }\r\n    match /{document=**} {\r\n      allow read, write: if false;\r\n    }\r\n  }\r\n}\r\n","name":"firestore.rules"}]},"createTime":"2026-10-11T01:11:51.414239Z","metadata":{"services":["cloud.firestore"]}}
